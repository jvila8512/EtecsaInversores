<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
  <!--
    Add telemetry columns to dato_inversor for complete register mapping coverage.
    These columns capture data available in both Felicity and MUST protocols
    that was previously unmapped.
  -->
  <changeSet id="20260611000002-1" author="etecsa" runOnChange="true">
    <preConditions onFail="MARK_RAN">
      <not>
        <columnExists tableName="dato_inversor" columnName="pv_corriente_a" />
      </not>
    </preConditions>
    <addColumn tableName="dato_inversor">
      <column name="pv_corriente_a" type="double precision" />
    </addColumn>
  </changeSet>
  <changeSet id="20260611000002-2" author="etecsa" runOnChange="true">
    <preConditions onFail="MARK_RAN">
