<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

  <!--
    Complete register mappings for Felicity Solar and MUST Power.
    Adds all telemetry registers that map to dato_inversor columns,
    including new columns (pv_corriente_a, salida_corriente_a, salida_frecuencia_hz,
    temperatura_c, bus_voltaje_v, soc_pct).

    Existing mapeos from 20260611000001 are NOT modified — these are ADDITIONAL mappings.
    No context="faker" → runs in all profiles.
  -->

  <!-- ============================================================ -->
  <!-- Felicity Solar — additional telemetry registers               -->
  <!-- Protocol: 0x1101–0x112A (Holding Registers, FC03)            -->
  <!-- Reference: Felicity Lumin Plus Modbus Protocol v2.x          -->
  <!-- ============================================================ -->
  <changeSet id="20260611000003-1" author="etecsa">

    <!-- 0x1105 (4357) PV Input Current -->
    <insert tableName="mapeo_registro">
      <column name="id" value="16"/>
      <column name="direccion_registro" value="4357"/>
      <column name="nombre_registro" value="PV Input Current"/>
      <column name="campo_sql" value="pv_corriente_a"/>
      <column name="tipo_dato" value="UnsignedInt16"/>
      <column name="escala" value="1"/>
      <column name="unidad" value="A"/>
      <column name="activo" value="true"/>
      <column name="descripcion" value="0x1105 — Corriente de entrada del panel solar"/>
      <column name="marca_id" value="1"/>
    </insert>

    <!-- 0x1106 (4358) PV Input Power — redundant with 0x112A, but useful for cross-check -->
    <insert tableName="mapeo_registro">
      <column name="id" value="17"/>
      <column name="direccion_registro" value="4358"/>
      <column name="nombre_registro" value="PV Input Power L"/>
