  <changeSet id="20260611000003-2" author="etecsa">

    <!-- 15201 PV Charger Work State → pv_activo (Work Mode = 2 means PV active) -->
    <insert tableName="mapeo_registro">
      <column name="id" value="50"/>
      <column name="direccion_registro" value="15201"/>
      <column name="nombre_registro" value="PV Charger Work State"/>
      <column name="campo_sql" value="pv_activo"/>
      <column name="tipo_dato" value="UnsignedInt16"/>
      <column name="escala" value="1"/>
      <column name="unidad" value=""/>
      <column name="activo" value="true"/>
      <column name="descripcion" value="Bloque B 15201 — Estado del cargador PV (0=Init,1=SelfTest,2=Work,3=Stop). &gt;0 = PV activo"/>
      <column name="marca_id" value="2"/>
    </insert>

    <!-- 15202 PV Charger MPPT State -->
    <insert tableName="mapeo_registro">
      <column name="id" value="51"/>
