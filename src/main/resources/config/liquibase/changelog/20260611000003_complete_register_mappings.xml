      <column name="campo_sql" value="temperatura_c"/>
      <column name="tipo_dato" value="UnsignedInt16"/>
      <column name="escala" value="1"/>
      <column name="unidad" value="°C"/>
      <column name="activo" value="true"/>
      <column name="descripcion" value="0x1107 — Temperatura interna del equipo"/>
